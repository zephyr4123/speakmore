{
  "name": "speakmore",
  "productName": "SpeakMore",
  "version": "0.19.0",
  "private": true,
  "description": "macOS 上的语音输入：按一下热键说话，整理好的文字贴进当前输入框。用你自己的 Gemini 或 OpenAI 的 key",
  "license": "MIT",
  "keywords": [
    "dictation",
    "voice-input",
    "speech-to-text",
    "macos",
    "gemini",
    "openai"
  ],
  "homepage": "https://github.com/zephyr4123/speakmore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zephyr4123/speakmore.git"
  },
  "type": "module",
  "main": "src/app/main.mjs",
  "bin": {
    "speakmore": "bin/speakmore.mjs"
  },
  "os": [
    "darwin",
    "win32"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "scripts": {
    "start": "node bin/speakmore.mjs",
    "build:native": "node scripts/build/build-native.mjs",
    "release": "node scripts/release/release.mjs",
    "publish-release": "node scripts/release/publish-release.mjs",
    "sync-models": "node scripts/release/sync-models.mjs",
    "stats": "node scripts/ops/stats.mjs",
    "i18n:zh-tw": "node scripts/dev/make-zh-tw.mjs",
    "ship": "sh scripts/release/ship.sh",
    "dist": "node scripts/build/package.mjs",
    "install-app": "sh scripts/build/install-app.sh",
    "test": "npm run test:unit && npm run test:install",
    "test:unit": "node --test --test-timeout=5000 \"test/*.test.mjs\" \"test/!(install)/**/*.test.mjs\"",
    "test:install": "node --test --test-timeout=120000 \"test/install/**/*.test.mjs\"",
    "test:e2e": "node scripts/dev/e2e.mjs",
    "test:native": "node scripts/dev/test-native.mjs",
    "lint": "biome check .",
    "check": "biome check . && npm test && npm run test:native"
  },
  "dependencies": {
    "@audio/decode-webm": "1.6.1",
    "@google/genai": "2.29.0",
    "electron": "44.7.0",
    "opencc-js": "1.4.2",
    "sherpa-onnx-node": "1.13.8",
    "transcribe-cpp": "0.4.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@audio/decode-opus": "1.3.3",
    "@biomejs/biome": "2.5.15",
    "@electron/get": "5.1.0",
    "@electron/packager": "20.3.0",
    "cos-nodejs-sdk-v5": "3.0.0",
    "tencentcloud-sdk-nodejs-cdn": "4.1.307"
  }
}
